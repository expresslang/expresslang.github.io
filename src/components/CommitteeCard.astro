---
interface Props {
  committee: import('@/lib/content').Committee
}

const { committee } = Astro.props
---

<div class="rounded-xl border border-gray-200/80 dark:border-gray-700/60 bg-white dark:bg-navy-light p-6 h-full flex flex-col transition-all duration-200 hover:border-elf-blue/30 dark:hover:border-elf-blue/30 hover:-translate-y-0.5 hover:shadow-md">
  <div class="flex items-baseline justify-between gap-2">
    <h3 class="font-serif font-bold text-lg text-gray-900 dark:text-white">{committee.name}</h3>
    <span class="shrink-0 font-mono text-[0.6rem] uppercase tracking-wider text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 rounded px-1.5 py-0.5">{committee.status}</span>
  </div>
  <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 leading-relaxed flex-1">{committee.scope}</p>
  <p class="mt-3 font-mono text-[0.65rem] text-gray-400 dark:text-gray-500">Standardization: <span class="text-elf-blue dark:text-elf-blue">{committee.standardization}</span></p>
</div>
