---
import { countryCode } from '@/lib/content'

interface Props {
  member: import('@/lib/content').Member
}

const { member } = Astro.props
const memberCode = countryCode(member.country)
const countryLabel = memberCode ? `${member.country} (${memberCode})` : member.country
---

<div class="rounded-xl border border-gray-200/80 dark:border-gray-700/60 bg-white dark:bg-navy-light p-6 h-full flex flex-col transition-all duration-200 hover:border-elf-blue/30 dark:hover:border-elf-blue/30 hover:-translate-y-0.5 hover:shadow-md" data-member-country={member.country}>
  <div class="mb-4 h-14 flex items-center rounded-lg bg-white p-2">
    <img src={member.logo} alt={member.name} loading="lazy" decoding="async" class="h-10 w-auto mx-auto object-contain" />
  </div>
  <div class="flex items-baseline justify-between gap-2">
    <h3 class="font-serif font-bold text-lg text-gray-900 dark:text-white">{member.name}</h3>
    <span class="shrink-0 font-mono text-[0.6rem] uppercase tracking-wider text-elf-blue dark:text-elf-blue border border-elf-blue/30 dark:border-elf-blue/30 rounded px-1.5 py-0.5">Founding</span>
  </div>
  <p class="mt-1 font-mono text-[0.65rem] text-gray-400 dark:text-gray-500">{countryLabel} · Member since {member.joined}</p>
  <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 leading-relaxed flex-1">{member.desc}</p>
  <a href={member.url} target="_blank" rel="noopener" class="mt-4 inline-flex items-center text-xs font-medium text-elf-blue dark:text-elf-blue hover:underline">
    Visit website
    <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
  </a>
</div>
