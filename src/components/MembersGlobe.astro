---
// Interactive orthographic globe of ELF members.
// Server: renders the first frame (initial rotation) so content is visible
// without JS. Client: versor (quaternion) inertial drag, auto-rotation with
// prefers-reduced-motion support, cursor tooltip, rotate-to-country legend
// buttons, and click-to-highlight member cards via data-member-country.
import { geoOrthographic, geoPath, geoGraticule10 } from 'd3-geo'
import { feature } from 'topojson-client'
import world from 'world-atlas/countries-110m.json'

interface Props {
  stats: Array<{ name: string; code: string | null; id: string; members: string[] }>
}

const { stats } = Astro.props

const INITIAL_ROTATE: [number, number] = [20, -12] // centers ~(-20°, 12°): Atlantic view
const SIZE = 640
const PAD = 20

const label = (s: { name: string; code: string | null }) => (s.code ? `${s.name} (${s.code})` : s.name)

const worldShapes = feature(world, world.objects.countries)
const projection = geoOrthographic()
  .rotate(INITIAL_ROTATE)
  .fitExtent(
    [
      [PAD, PAD],
      [SIZE - PAD, SIZE - PAD],
    ],
    { type: 'Sphere' },
  )
const pathGen = geoPath(projection)

// Hong Kong has no polygon in Natural Earth 110m — it is part of the CN
// feature. Highlight the containing polygon alongside the member country.
const FEATURE_FALLBACKS: Record<string, string> = { '344': '156' }
const memberById = new Map(stats.map((s) => [s.id, s]))
// reverse: feature id -> stat for member countries without their own polygon
const memberByFeatureFallback = new Map(
  Object.entries(FEATURE_FALLBACKS).map(([memberId, featureId]) => [featureId, memberById.get(memberId)]),
)

// UN compliance: Natural Earth ships de-facto states without ISO 3166-1 codes
// (Somaliland, N. Cyprus, Kosovo). Fold their geometry into the UN member state
// they belong to, so they never appear as countries on the map.
const UN_INTO: Record<string, string> = {
  'N. Cyprus': '196', // Cyprus
  Somaliland: '706', // Somalia
  Kosovo: '688', // Serbia (UNSCR 1244)
}
const unMerge = (features: Array<Record<string, unknown>>) => {
  const byId = new Map<string, Record<string, unknown>>()
  for (const f of features) {
    if (f.id != null) byId.set(String(f.id).padStart(3, '0'), f)
  }
  const merged = new Map<string, Record<string, unknown>>()
  for (const f of features) {
    if (f.id != null) {
      merged.set(String(f.id).padStart(3, '0'), f)
      continue
    }
    const parentId = UN_INTO[(f.properties as { name?: string })?.name ?? '']
    const parent = parentId ? merged.get(parentId) : undefined
    if (!parent) continue // unknown entity: excluded rather than shown as a country
    appendGeometry(parent, f)
  }
  return [...merged.values()]
}
const appendGeometry = (parent: Record<string, unknown>, child: Record<string, unknown>) => {
  const ringsOf = (g: Record<string, unknown>) =>
    (g.type === 'MultiPolygon' ? g.coordinates : g.type === 'Polygon' ? [g.coordinates] : []) as unknown[][]
  const coords = [...ringsOf(parent.geometry), ...ringsOf(child.geometry)]
  parent.geometry = { type: 'MultiPolygon', coordinates: coords }
}
const displayFeatures = unMerge(worldShapes.features)
const countryPaths = displayFeatures.map((f) => {
  const id = String(f.id).padStart(3, '0')
  return {
    id,
    d: pathGen(f),
    stat: memberById.get(id) ?? memberByFeatureFallback.get(id),
  }
})
const graticuleD = pathGen(geoGraticule10())
const sphereD = pathGen({ type: 'Sphere' })

const serialized = JSON.stringify(stats.map((s) => ({ ...s, members: s.members })))
const serializedRotate = JSON.stringify(INITIAL_ROTATE)
---

<section
  class="mb-16"
  aria-label="Interactive globe of member countries"
  data-globe-section
  data-globe-members={serialized}
  data-globe-rotate={serializedRotate}
  data-globe-size={String(SIZE)}
  data-globe-pad={String(PAD)}
>
  <div class="relative max-w-[540px] mx-auto" data-globe-wrap>
    <svg
      id="members-globe"
      viewBox={`0 0 ${SIZE} ${SIZE}`}
      class="globe-svg w-full h-auto rounded-full select-none"
      style="touch-action: pan-y;"
      role="group"
      aria-label={`Rotatable globe showing ELF members: ${stats.map((s) => label(s)).join(', ')}`}
      data-globe-svg
    >
      <path d={sphereD} class="globe-sphere" />
      <path d={graticuleD} class="globe-graticule" />
      {
        countryPaths.map((p) => (
          <path
            d={p.d}
            class={p.stat ? 'map-country map-country--member' : 'map-country'}
            data-country={p.stat?.name}
            data-feature-id={p.id}
            tabindex={p.stat ? 0 : undefined}
            aria-label={p.stat ? `${label(p.stat)} — ${p.stat.members.length} member${p.stat.members.length === 1 ? '' : 's'}` : undefined}
          >
            {p.stat && <title>{`${label(p.stat)}: ${p.stat.members.join(' · ')}`}</title>}
          </path>
        ))
      }
    </svg>
    <button
      type="button"
      data-globe-reset
      title="Reset view"
      aria-label="Reset globe view"
      class="absolute top-3 right-3 z-10 p-2 rounded-full border border-gray-200/80 dark:border-gray-700/60 bg-white/90 dark:bg-navy-light/90 text-gray-500 dark:text-gray-400 hover:text-elf-blue dark:hover:text-elf-blue hover:border-elf-blue/40 transition-colors shadow-sm"
    >
      <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h5M20 20v-5h-5M20 9A8 8 0 005.6 5.6L4 9m16 10a8 8 0 01-14.4 3.4L4 15"/></svg>
    </button>
    <div
      data-globe-tooltip
      aria-hidden="true"
      class="hidden absolute z-10 pointer-events-none rounded-lg border border-gray-200/80 dark:border-gray-700/60 bg-white dark:bg-navy-light shadow-lg px-3 py-2 max-w-[240px]"
    >
      <p class="font-serif font-bold text-sm text-gray-900 dark:text-white" data-globe-tooltip-title></p>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400 leading-relaxed" data-globe-tooltip-body></p>
    </div>
  </div>

  <ul class="mt-8 flex flex-wrap justify-center gap-2" data-globe-legend>
    {
      stats.map((s) => (
        <li>
          <button
            type="button"
            data-globe-rotate={s.name}
            title={`Rotate the globe to ${s.name}`}
            class="font-mono text-xs text-elf-blue dark:text-elf-blue border border-elf-blue/30 dark:border-elf-blue/30 rounded-full px-3 py-1.5 hover:bg-elf-blue/8 dark:hover:bg-elf-blue/10 hover:border-elf-blue/60 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-elf-blue/50"
          >
            {label(s)} — {s.members.length}
          </button>
        </li>
      ))
    }
  </ul>
</section>

<script>
  import { geoOrthographic, geoPath, geoGraticule10, geoCentroid, geoArea } from 'd3-geo'
  import { feature } from 'topojson-client'
  import versor from 'versor'
  import worldUrl from 'world-atlas/countries-110m.json?url'

  const AUTO_RESUME_MS = 3000
  const AUTO_SPEED = 3.2 // degrees per second, eased in
  const DRAG_SUPPRESS_PX = 6
  const DEG_PER_RAD = 180 / Math.PI

  // Canonical versor-dragging (Bostock/Fil): screen -> invert -> earth cartesian,
  // incremental quaternion composition. Screen-frame hand-mapping is precisely
  // what breaks this projection — do not replace invert with manual sphere math.

  // UN compliance: fold Natural Earth's de-facto states (no ISO 3166-1 code)
  // into the UN member state they belong to — identical to the SSR merge.
  const UN_INTO: Record<string, string> = {
    'N. Cyprus': '196', // Cyprus
    Somaliland: '706', // Somalia
    Kosovo: '688', // Serbia (UNSCR 1244)
  }
  const FEATURE_FALLBACKS: Record<string, string> = { '344': '156' } // Hong Kong -> CN polygon
  const appendGeometry = (parent: Record<string, unknown>, child: Record<string, unknown>) => {
    const ringsOf = (g: Record<string, unknown>) =>
      (g.type === 'MultiPolygon' ? g.coordinates : g.type === 'Polygon' ? [g.coordinates] : []) as unknown[][]
    parent.geometry = {
      type: 'MultiPolygon',
      coordinates: [...ringsOf(parent.geometry), ...ringsOf(child.geometry)],
    }
  }
  const unMerge = (features: Array<Record<string, unknown>>) => {
    const byId = new Map<string, Record<string, unknown>>()
    for (const f of features) {
      if (f.id != null) byId.set(String(f.id).padStart(3, '0'), f)
    }
    const merged = new Map<string, Record<string, unknown>>()
    for (const f of features) {
      if (f.id != null) {
        merged.set(String(f.id).padStart(3, '0'), f)
        continue
      }
      const parentId = UN_INTO[(f.properties as { name?: string })?.name ?? '']
      const parent = parentId ? merged.get(parentId) : undefined
      if (!parent) continue // unknown entity: excluded rather than shown as a country
      appendGeometry(parent, f)
    }
    return [...merged.values()]
  }

  // Centroid of the largest polygon of a feature — the "main location".
  // Multipolygons bundle distant territories (France includes French Guiana,
  // the US includes Alaska), which drag the raw centroid off the mainland.
  const mainLandmassCentroid = (f: object): [number, number] => {
    const geometry = (f as { geometry?: { type?: string; coordinates?: unknown } }).geometry
    if (geometry?.type !== 'MultiPolygon') return geoCentroid(f)
    let best: { type: string; coordinates: unknown } | null = null
    let bestArea = -1
    for (const polygon of geometry.coordinates as unknown[][]) {
      const g = { type: 'Polygon', coordinates: polygon }
      const a = geoArea(g as never)
      if (a > bestArea) {
        bestArea = a
        best = g
      }
    }
    return best ? geoCentroid(best) : geoCentroid(f)
  }

  for (const section of document.querySelectorAll<HTMLElement>('[data-globe-section]')) {
    const svg = section.querySelector<SVGSVGElement>('[data-globe-svg]')
    if (!svg) continue

    const size = Number(section.dataset.globeSize)
    const pad = Number(section.dataset.globePad)
    const initial = JSON.parse(section.dataset.globeRotate!) as [number, number]
    const stats = JSON.parse(section.dataset.globeMembers!) as Array<{
      name: string
      code: string | null
      id: string
      members: string[]
    }>

    const projection = geoOrthographic()
      .rotate(initial)
      .fitExtent(
        [
          [pad, pad],
          [size - pad, size - pad],
        ],
        { type: 'Sphere' },
      )
    const pathGen = geoPath(projection)
    const graticuleObj = geoGraticule10()
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const graticuleEl = svg.querySelector<SVGPathElement>('.globe-graticule')!
    const paths = new Map<string, SVGPathElement>()
    svg.querySelectorAll<SVGPathElement>('path.map-country').forEach((el) => {
      paths.set(el.dataset.featureId!, el)
      el.querySelector('title')?.remove()
    })
    const memberPaths = svg.querySelectorAll<SVGPathElement>('path.map-country--member')

    const featuresById = new Map<string, object>()
    const centroids = new Map<string, [number, number]>()

    let loaded = false
    let dirty = false
    fetch(worldUrl)
      .then((r) => r.json())
      .then((topo) => {
        const shapeList = unMerge(feature(topo, topo.objects.countries).features as Array<Record<string, unknown>>)
        for (const f of shapeList) {
          const id = String(f.id).padStart(3, '0')
          featuresById.set(id, f)
          if (paths.has(id)) centroids.set(id, mainLandmassCentroid(f as object))
        }
        loaded = true
        dirty = true
      })

    // Orientation: one quaternion, converted to Euler angles only for render
    // and idle motions. Never clamped mid-gesture.
    let Q = versor(initial) as unknown as number[]
    const applyQ = () => {
      projection.rotate(versor.rotation(Q as unknown as [number, number, number]) as [number, number, number])
      graticuleEl.setAttribute('d', pathGen(graticuleObj) ?? '')
      for (const [id, el] of paths) {
        el.setAttribute('d', pathGen(featuresById.get(id) as object) ?? '')
      }
    }

    // --- yaw-only drag (left/right spin; the poles stay put) -------------------
    // Pure yaw is a single longitude rotation — absolute from drag start,
    // no incremental state, cannot drift or jitter. Vertical drags do nothing.
    let dragging = false
    let startClientX = 0
    let startAngles: [number, number, number] | null = null
    let vel = 0
    let lastYaw = versor.rotation(Q as unknown as [number, number, number])[0]
    let lastMoveT = 0
    let lastInteraction = 0
    let moved = 0
    let lastX: number | null = null
    let suppressClick = false

    const point = (e: PointerEvent): [number, number] => {
      const rect = svg.getBoundingClientRect()
      return [((e.clientX - rect.left) * size) / rect.width, ((e.clientY - rect.top) * size) / rect.height]
    }
    const insideGlobe = (p: [number, number]) =>
      Math.hypot(p[0] - projection.translate()[0], p[1] - projection.translate()[1]) <= projection.scale()

    const endDrag = () => {
      if (!dragging) return
      dragging = false
      startAngles = null
      svg.classList.remove('is-dragging')
      suppressClick = moved > DRAG_SUPPRESS_PX
      lastInteraction = performance.now()
      window.removeEventListener('pointermove', onWindowMove)
      window.removeEventListener('pointerup', endDrag)
      window.removeEventListener('pointercancel', endDrag)
    }
    const onWindowMove = (e: PointerEvent) => {
      if (!dragging || !startAngles) return
      const now = performance.now()
      const dt = Math.max(now - lastMoveT, 1)
      const degPerPx = DEG_PER_RAD / projection.scale() // surface-true at the equator
      const yaw = startAngles[0] + (e.clientX - startClientX) * degPerPx
      const instant = ((yaw - lastYaw) / dt) * 1000
      if (Number.isFinite(instant) && Math.abs(instant) < 4000) vel = vel * 0.5 + instant * 0.5
      lastYaw = yaw
      Q = versor([yaw, startAngles[1], 0]) as unknown as number[]
      moved += Math.abs(e.clientX - (lastX ?? e.clientX))
      lastX = e.clientX
      lastMoveT = now
      lastInteraction = now
      dirty = true
    }

    svg.addEventListener('pointerdown', (e) => {
      if (dragging) return
      const p = point(e)
      if (!insideGlobe(p)) return
      // gesture state first — nothing after this point may throw before it lands
      dragging = true
      suppressClick = false
      moved = 0
      vel = 0
      lastX = e.clientX
      startClientX = e.clientX
      lastMoveT = performance.now()
      lastInteraction = lastMoveT
      startAngles = versor.rotation(Q as unknown as [number, number, number]) as [number, number, number]
      svg.classList.add('is-dragging')
      try {
        svg.setPointerCapture(e.pointerId)
      } catch {
        // Safari/older Chrome: capture unavailable — window listeners still track
      }
      window.addEventListener('pointermove', onWindowMove)
      window.addEventListener('pointerup', endDrag)
      window.addEventListener('pointercancel', endDrag)
    })

    // --- hover pauses auto-rotation; cursor handled by CSS --------------------
    let hovering = false
    svg.addEventListener('pointerenter', () => (hovering = true))
    svg.addEventListener('pointerleave', () => {
      hovering = false
      lastInteraction = performance.now()
    })

    // --- tooltip ---------------------------------------------------------------
    const tooltip = section.querySelector<HTMLElement>('[data-globe-tooltip]')!
    const tooltipTitle = tooltip.querySelector('[data-globe-tooltip-title]')!
    const tooltipBody = tooltip.querySelector('[data-globe-tooltip-body]')!
    const wrap = section.querySelector<HTMLElement>('[data-globe-wrap]')!

    const moveTooltip = (e: PointerEvent) => {
      const rect = wrap.getBoundingClientRect()
      const x = e.clientX - rect.left
      const y = e.clientY - rect.top
      tooltip.style.left = `${Math.min(Math.max(x + 14, 0), rect.width - tooltip.offsetWidth)}px`
      tooltip.style.top = `${Math.max(y - tooltip.offsetHeight - 10, 0)}px`
    }
    const showTooltip = (el: SVGPathElement, e: PointerEvent) => {
      const stat = stats.find((s) => s.name === el.dataset.country)
      if (!stat) return
      const name = stat.code ? `${stat.name} (${stat.code})` : stat.name
      tooltipTitle.textContent = name
      tooltipBody.textContent = `${stat.members.length} member${stat.members.length === 1 ? '' : 's'}: ${stat.members.join(' · ')}`
      tooltip.classList.remove('hidden')
      moveTooltip(e)
    }
    svg.addEventListener('pointerover', (e) => {
      const target = (e.target as Element).closest('path.map-country--member')
      if (target) showTooltip(target as SVGPathElement, e)
    })
    svg.addEventListener('pointermove', (e) => {
      if (!tooltip.classList.contains('hidden')) moveTooltip(e)
    })
    svg.addEventListener('pointerout', (e) => {
      const from = (e.target as Element).closest('path.map-country--member')
      const to = (e.relatedTarget as Element | null)?.closest?.('path.map-country--member')
      if (from && from !== to) tooltip.classList.add('hidden')
    })

    // --- highlight member cards ------------------------------------------------
    const flashCards = (name: string) => {
      const cards = document.querySelectorAll<HTMLElement>(`[data-member-country="${CSS.escape(name)}"]`)
      cards.forEach((c) => c.classList.add('ring-2', 'ring-elf-blue', 'ring-offset-2'))
      window.setTimeout(() => cards.forEach((c) => c.classList.remove('ring-2', 'ring-elf-blue', 'ring-offset-2')), 2200)
    }

    svg.addEventListener(
      'click',
      (e) => {
        if (suppressClick) return // drag ended here; not a click
        const target = (e.target as Element).closest('path.map-country--member') as SVGPathElement | null
        const name = target?.dataset.country
        if (name) rotateTo(name, () => flashCards(name))
      },
      true,
    )

    // --- rotate to a country (quaternion slerp) --------------------------------
    let animating = false
    const animateTo = (target: [number, number, number], then?: () => void) => {
      vel = 0
      const current = versor.rotation(Q as unknown as [number, number, number]) as [number, number, number]
      if (reducedMotion) {
        Q = versor(target) as unknown as number[]
        dirty = true
        then?.()
        return
      }
      const interpolate = versor.interpolate(current, target)
      const t0 = performance.now()
      const duration = 850
      lastInteraction = t0 + duration
      animating = true
      const step = (t: number) => {
        const p = Math.min((t - t0) / duration, 1)
        const eased = 1 - Math.pow(1 - p, 3)
        Q = interpolate(eased) as unknown as number[]
        lastYaw = versor.rotation(Q as unknown as [number, number, number])[0]
        dirty = true
        if (p < 1) requestAnimationFrame(step)
        else {
          animating = false
          then?.()
        }
      }
      requestAnimationFrame(step)
    }
    // Navigation spins only — longitude animates to face the country's
    // meridian; the tilt stays exactly where the user left it.
    const rotateTo = (name: string, then?: () => void) => {
      const stat = stats.find((s) => s.name === name)
      const c = stat && (centroids.get(stat.id) ?? centroids.get(FEATURE_FALLBACKS[stat.id]))
      if (!c) return
      const current = versor.rotation(Q as unknown as [number, number, number]) as [number, number, number]
      let dλ = -c[0] - current[0]
      dλ = ((dλ + 540) % 360) - 180
      animateTo([current[0] + dλ, current[1], 0], then)
    }
    const resetView = (then?: () => void) => animateTo([initial[0], initial[1], 0], then)

    for (const btn of section.querySelectorAll<HTMLButtonElement>('[data-globe-rotate]')) {
      btn.addEventListener('click', () => rotateTo(btn.dataset.globeRotate!, () => flashCards(btn.dataset.globeRotate!)))
    }
    section.querySelector('[data-globe-reset]')?.addEventListener('click', () => resetView())
    memberPaths.forEach((el) => {
      el.addEventListener('focus', () => rotateTo(el.dataset.country!))
      el.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
          e.preventDefault()
          if (el.dataset.country) flashCards(el.dataset.country)
        }
      })
    })

    // --- animation loop (paused offscreen; one DOM flush per frame) ------------
    let visible = true
    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(svg)

    let lastFrame = performance.now()
    const loop = (t: number) => {
      const dt = Math.min(t - lastFrame, 100)
      lastFrame = t
      if (visible && loaded) {
        if (!dragging && !animating && !hovering) {
          const angles = versor.rotation(Q as unknown as [number, number, number]) as [number, number, number]
          if (Math.abs(vel) > 1) {
            angles[0] += (vel * dt) / 1000
            vel *= Math.pow(0.95, dt / 16.7)
            angles[2] *= Math.pow(0.98, dt / 16.7) // gently self-level
            lastInteraction = t
            Q = versor(angles) as unknown as number[]
            dirty = true
          } else if (!reducedMotion && t - lastInteraction > AUTO_RESUME_MS) {
            const since = t - lastInteraction - AUTO_RESUME_MS
            const ramp = Math.min(since / 1200, 1)
            angles[0] += (AUTO_SPEED * ramp * dt) / 1000
            angles[2] *= Math.pow(0.995, dt / 16.7)
            Q = versor(angles) as unknown as number[]
            dirty = true
          }
        }
        if (dirty) {
          applyQ()
          dirty = false
        }
      }
      requestAnimationFrame(loop)
    }
    requestAnimationFrame(loop)
  }
</script>

<style>
  .globe-svg {
    cursor: grab;
  }
  .globe-svg:active,
  .globe-svg.is-dragging {
    cursor: grabbing;
  }
  .globe-sphere {
    fill: var(--globe-ocean, #dce6f1);
  }
  :global(.dark) .globe-sphere {
    fill: #1f2c42;
  }
  .globe-graticule {
    fill: none;
    stroke: var(--globe-graticule, #ffffff);
    stroke-width: 0.5;
  }
  :global(.dark) .globe-graticule {
    stroke: #2b3d59;
  }
  .map-country {
    fill: var(--map-land, #d8dde4);
    stroke: var(--map-border, #ffffff);
    stroke-width: 0.5;
  }
  :global(.dark) .map-country {
    fill: #31445e;
    stroke: #1e293b;
  }
  .map-country--member {
    fill: var(--elf-blue, #2f6bbf);
    cursor: pointer;
  }
  :global(.dark) .map-country--member {
    fill: #5b8dd9;
  }
  .map-country--member:hover,
  .map-country--member:focus-visible {
    fill: #1e4f9e;
  }
  /* SVG outlines render as a rectangle around the path's bounding box — use a
     shape-following stroke for the keyboard focus indicator instead. */
  .map-country--member:focus-visible {
    stroke: #1e4f9e;
    stroke-width: 1.6;
  }
  :global(.dark) .map-country--member:focus-visible {
    stroke: #d7e5f7;
  }
</style>
