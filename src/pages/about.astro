---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/PageHero.astro'
import AsciiDocContent from '@/components/AsciiDocContent.astro'
import { getContent } from '@/lib/content'

const content = getContent('pages', 'about')
const title = content?.title || 'About'
---

<BaseLayout title={title}>
  <PageHero eyebrow="About" title={title} crumbs={[{ label: 'Home', to: '/' }, { label: title }]} width="3xl" compact />
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    {
      content ? (
        <AsciiDocContent html={content.body} />
      ) : (
        <div class="text-center py-20 text-gray-400">
          <p class="font-mono text-sm">Content not available yet.</p>
        </div>
      )
    }
  </div>
</BaseLayout>
