---
import BaseLayout from '@/layouts/BaseLayout.astro'
import AsciiDocContent from '@/components/AsciiDocContent.astro'
import Sidebar from '@/components/Sidebar.astro'
import { getContent, toNavItems } from '@/lib/content'

export function getStaticPaths() {
  return toNavItems('learn').map((item) => ({ params: { slug: item.slug } }))
}

const { slug } = Astro.params
const content = getContent('learn', slug!)

const items = toNavItems('learn')
const idx = items.findIndex((i) => i.slug === slug)
const prev = idx > 0 ? items[idx - 1] : null
const next = idx < items.length - 1 ? items[idx + 1] : null
const baseUrl = '/learn/tutorial'
---

<BaseLayout title={content?.title ?? 'Tutorial'}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="lg:flex lg:gap-8">
      <Sidebar items={items} currentSlug={slug!} baseUrl={baseUrl} />
      <div class="flex-1 min-w-0">
        {
          content && (
            <>
              <nav class="text-sm text-gray-400 dark:text-gray-500 mb-8">
                <a href="/" class="hover:text-elf-blue dark:hover:text-elf-blue transition-colors">Home</a>
                <span class="mx-2 text-gray-300 dark:text-gray-600">/</span>
                <a href="/learn" class="hover:text-elf-blue dark:hover:text-elf-blue transition-colors">EXPRESS Language Reference Course</a>
                <span class="mx-2 text-gray-300 dark:text-gray-600">/</span>
                <span class="text-gray-600 dark:text-gray-300">{content.title}</span>
              </nav>
              <h1 class="text-3xl sm:text-4xl font-serif font-bold text-gray-900 dark:text-white leading-tight mb-10">{content.title}</h1>
              <AsciiDocContent html={content.body} />
              <div class="flex justify-between items-center mt-16 pt-8 border-t border-gray-200/60 dark:border-gray-700/40">
                {prev ? (
                  <a href={`${baseUrl}/${prev.slug}`} class="group flex flex-col items-start text-left min-h-[44px] justify-center max-w-[45%]">
                    <span class="text-[0.65rem] font-mono uppercase tracking-wider text-gray-400 dark:text-gray-500 mb-1">Previous</span>
                    <span class="text-sm font-medium text-gray-700 dark:text-gray-200 group-hover:text-elf-blue dark:group-hover:text-elf-blue transition-colors">&larr; {prev.title}</span>
                  </a>
                ) : (
                  <span />
                )}
                {next && (
                  <a href={`${baseUrl}/${next.slug}`} class="group flex flex-col items-end text-right min-h-[44px] justify-center max-w-[45%]">
                    <span class="text-[0.65rem] font-mono uppercase tracking-wider text-gray-400 dark:text-gray-500 mb-1">Next</span>
                    <span class="text-sm font-medium text-gray-700 dark:text-gray-200 group-hover:text-elf-blue dark:group-hover:text-elf-blue transition-colors">{next.title} &rarr;</span>
                  </a>
                )}
              </div>
            </>
          )
        }
        {
          !content && (
            <div class="text-center py-20">
              <p class="text-2xl font-serif font-bold text-gray-900 dark:text-white">Page not found</p>
              <a href="/learn" class="mt-4 inline-block text-elf-blue dark:text-elf-blue hover:underline">&larr; Back to course</a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
