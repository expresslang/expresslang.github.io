---
import BaseLayout from '@/layouts/BaseLayout.astro'
import AnimatedSection from '@/components/AnimatedSection.astro'
import PageHero from '@/components/PageHero.astro'
import MemberCard from '@/components/MemberCard.astro'
import PersonCard from '@/components/PersonCard.astro'
import { members, peopleByRank } from '@/lib/content'

const orgs = members.filter((m) => m.category !== 'individual')
const individuals = peopleByRank('founder')
---

<BaseLayout
  title="Members"
  description="The members of the EXPRESS Language Foundation — organizations and individuals worldwide."
>
  <PageHero
    eyebrow="Membership"
    title="Our Members"
    lead="ELF members are organizations and individuals worldwide who have joined the Foundation to develop, standardize, and promote the EXPRESS language family. Members participate and vote in the technical committees."
    crumbs={[{ label: 'Home', to: '/' }, { label: 'Members' }]}
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
    <AnimatedSection>
      <section class="mb-16" aria-label="World map of member countries">
        <!-- Interactive members map is added in Task 3b here -->
      </section>
    </AnimatedSection>

    <section class="mb-20">
      <AnimatedSection>
        <h2 class="text-xl font-serif font-bold text-gray-900 dark:text-white mb-2">Founding Members</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-8">
          Organizations designated by the Board as inaugural members of the Foundation.
        </p>
      </AnimatedSection>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {orgs.map((member, i) => (
          <AnimatedSection delay={i * 60}>
            <MemberCard member={member} />
          </AnimatedSection>
        ))}
      </div>
    </section>

    <section>
      <AnimatedSection>
        <h2 class="text-xl font-serif font-bold text-gray-900 dark:text-white mb-2">Individual Members</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-8">
          Experts and practitioners participating in the Foundation's technical committees —
          including the original inventors and stewards of the EXPRESS language family.
        </p>
      </AnimatedSection>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {individuals.map((person, i) => (
          <AnimatedSection delay={i * 60}>
            <PersonCard person={person} size="founder" />
          </AnimatedSection>
        ))}
      </div>
    </section>

    <AnimatedSection>
      <div class="mt-16 rounded-xl border border-gray-200/80 dark:border-gray-700/60 bg-slate-50 dark:bg-navy-light p-8 text-center">
        <h2 class="text-lg font-serif font-bold text-gray-900 dark:text-white">Become a member</h2>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
          Membership is open to organizations and individuals worldwide. See the
          categories, fees, and how to join.
        </p>
        <a href="/membership" class="mt-4 inline-flex items-center text-sm font-medium text-elf-blue dark:text-elf-blue hover:underline">
          Join the EXPRESS Language Foundation
          <svg class="w-4 h-4 inline ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </AnimatedSection>
  </div>
</BaseLayout>
