---
import BaseLayout from '@/layouts/BaseLayout.astro'
import AsciiDocContent from '@/components/AsciiDocContent.astro'
import LinkedInIcon from '@/components/LinkedInIcon.astro'
import { getContent, people } from '@/lib/content'

export function getStaticPaths() {
  return people.map((person) => ({ params: { slug: person.slug } }))
}

const { slug } = Astro.params
const content = getContent('people', slug!)
const person = people.find((p) => p.slug === slug)
---

<BaseLayout title={content?.title ?? ''}>
  {
    content ? (
      <>
        <!-- Hero -->
        <div class="bg-gradient-to-b from-slate-50 to-white dark:from-navy dark:to-navy-light/30 pt-12 pb-12">
          <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-gray-400 dark:text-gray-500 mb-6 flex items-center gap-1.5">
              <a href="/" class="hover:text-elf-blue dark:hover:text-elf-blue transition-colors">Home</a>
              <span class="text-gray-300 dark:text-gray-600">/</span>
              <a href="/leadership" class="hover:text-elf-blue dark:hover:text-elf-blue transition-colors">Leadership</a>
              <span class="text-gray-300 dark:text-gray-600">/</span>
              <span class="text-gray-700 dark:text-gray-300">{content.title}</span>
            </nav>
            <div class="flex items-center gap-5">
              {person?.photo ? (
                <img src={person.photo} alt={person.name} width="64" height="64" class="w-16 h-16 rounded-full object-cover shrink-0" />
              ) : (
                <div class="w-16 h-16 rounded-full bg-elf-blue/10 dark:bg-elf-blue/10 flex items-center justify-center shrink-0">
                  <span class="text-2xl font-serif font-bold text-elf-blue dark:text-elf-blue">{content.title.charAt(0)}</span>
                </div>
              )}
              <div>
                <h1 class="text-3xl sm:text-4xl font-serif font-bold text-gray-900 dark:text-white leading-tight">{content.title}</h1>
                {person?.role && <p class="font-mono text-sm text-elf-blue dark:text-elf-blue tracking-wide mt-1">{person.role}</p>}
              </div>
              {person?.linkedin && (
                <a
                  href={person.linkedin}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${person.name} on LinkedIn`}
                  class="ml-auto shrink-0 p-2 rounded-md text-gray-400 dark:text-gray-500 hover:text-elf-blue dark:hover:text-elf-blue hover:bg-elf-blue/5 dark:hover:bg-elf-blue/5 transition-colors"
                >
                  <LinkedInIcon class="w-5 h-5" />
                </a>
              )}
            </div>
          </div>
        </div>

        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
          <AsciiDocContent html={content.body} />
        </div>
      </>
    ) : (
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
        <p class="text-2xl font-serif font-bold text-gray-900 dark:text-white">Person not found</p>
        <a href="/leadership" class="mt-4 inline-block text-elf-blue dark:text-elf-blue hover:underline">&larr; Back to Leadership</a>
      </div>
    )
  }
</BaseLayout>
