    "@tailwindcss/typography": "^0.5.16",
    "@types/js-yaml": "^4.0.9",
    "concurrently": "^9.1.2",
    "globby": "^14.1.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.21",
    "tailwindcss": "^4.0.14",
